# Copy to .env and fill in. .env is gitignored — never commit real values.
#
# Supabase project credentials. The anon key is safe to ship in a mobile client
# (RLS enforces access); the service-role key must NEVER appear here.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# FastAPI backend base URL, no trailing slash.
#   Android emulator ....... http://10.0.2.2:8000   (localhost is the emulator itself)
#   iOS simulator .......... http://localhost:8000
#   Physical device ........ http://<your-LAN-IP>:8000
# Add whichever origin you use to CORS_ORIGINS in the backend's .env.
API_BASE_URL=http://10.0.2.2:8000

# Weather feature — not part of the RepLiT v8 scope. Remove this and the
# lib/features/weather/ folder if the feature is dropped.
OPENWEATHERMAP_API_KEY=
