# Copy to .env and fill in. .env is gitignored — never commit real values.
#
# Supabase project credentials. The anon key is safe to ship in a mobile client
# (RLS enforces access); the service-role key must NEVER appear here.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Weather feature — not part of the RepLiT v8 scope. Remove this and the
# lib/features/weather/ folder if the feature is dropped.
OPENWEATHERMAP_API_KEY=
