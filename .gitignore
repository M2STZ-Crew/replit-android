# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# ── RepLiT ──────────────────────────────────────────────────────────────────
# Firebase client config. Not a server secret — the values ship inside the APK
# either way, and Firebase security comes from its rules, not from hiding this
# file. It is ignored because it ties the repo to one Firebase project: a
# teammate cloning this should register their own and drop theirs in.
# Keep android/app/google-services.example.json in sync when its shape changes.
android/app/google-services.json
ios/Runner/GoogleService-Info.plist

# Release signing. A keystore and its passwords must never reach the repo —
# anyone holding them can publish an update as you.
android/key.properties
**/*.jks
**/*.keystore

# Local tool state
.flutter-plugins

# Build-time configuration: the Mapbox token and the API base URL.
# Copy env.example.json to env.json and fill it in. Never commit env.json —
# this repository is public, and scrapers harvest tokens from public repos.
env.json
