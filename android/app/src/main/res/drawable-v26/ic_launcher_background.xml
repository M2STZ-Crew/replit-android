<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher icon's ground: #131313, full bleed, with the soft coral
     glow behind the mark (radial, #FF7943 at 22 % to clear, centred at
     54, 50 with a 40 dp radius). Only adaptive icons (API 26+) use it, and
     vector gradients need API 24, hence drawable-v26.
     Figma: REPLIT (MAIN), 04 · App icon · Android launcher · pass 4, REPLIT / App Icon / Background (604:1711).
     Path data copied unchanged from the Figma SVG export. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android" xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#131313"
        android:pathData="M0,0h108v108h-108z" />
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="50"
                android:gradientRadius="40"
                android:startColor="#38FF7943"
                android:endColor="#00FF7943" />
        </aapt:attr>
    </path>
</vector>
