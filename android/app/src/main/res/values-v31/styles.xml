<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ draws its own splash before the app runs: by default the
         whole launcher icon, dark tile and all, on the window background. On
         a phone in light mode that put the dark-ground icon on a white
         screen. Here the splash shows only the flame-and-pin mark (the icon's
         foreground layer, no tile) on the light ground the app uses. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/launch_ground</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
    </style>
    <!-- The launch screen on the app's own ground rather than the phone's:
         Android 13+ keeps whichever MainActivity last chose ("launchGround",
         lib/theme_choice.dart) and uses it from the next launch on. -->
    <style name="SplashOnLight" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">#EEEDEA</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
    </style>
    <style name="SplashOnDark" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">#131313</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
