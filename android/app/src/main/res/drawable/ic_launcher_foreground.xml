<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher icon's mark (v1.12.49): the iPhone icon's flame and pin
     (ios/Runner/Assets.xcassets/AppIcon), with the iPhone's whole square on
     the 72 dp a launcher shows of this 108 dp layer, so the mark sits as it
     does on an iPhone. Made from the iPhone's 1024 px icon for each density
     (mipmap-*/ic_launcher_mark.png). -->
<bitmap xmlns:android="http://schemas.android.com/apk/res/android"
    android:src="@mipmap/ic_launcher_mark"
    android:gravity="fill"
    android:filter="true" />
