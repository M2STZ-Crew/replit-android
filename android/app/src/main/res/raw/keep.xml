<?xml version="1.0" encoding="utf-8"?>
<!-- The alert sounds are named by the server ("sound": "sound_fire", ...) and by
     the notification channels, never in a way the release build's resource
     shrinker can see — without this they would be stripped from the APK and
     alerts would ring with the default tone. -->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@raw/sound_fire,@raw/sound_police,@raw/sound_medical,@raw/sound_barangay,@raw/sound_citizen,@drawable/ic_stat_replit" />
