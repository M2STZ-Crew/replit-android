<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher icon from API 26 on: the ground and the mark as separate
     layers, so the launcher can mask them to whatever shape it uses and move
     them apart when the icon is animated. The monochrome layer is the same
     mark, which Android 13+ tints for themed icons. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
