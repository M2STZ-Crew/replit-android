<?xml version="1.0" encoding="utf-8"?>
<!-- The launch screen on Android 11 and older: the app's ground with the
     flame-and-pin mark in the middle, at the size the app's splash draws it
     next (values-sw*dp/dimens.xml), so the mark stays put when the app takes
     over. Android 12+ draws its own launch screen from values-v31/styles.xml. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_ground" />
    <item
        android:width="@dimen/launch_mark_width"
        android:height="@dimen/launch_mark_height"
        android:gravity="center"
        android:drawable="@drawable/launch_mark" />
</layer-list>
