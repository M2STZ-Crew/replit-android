<?xml version="1.0" encoding="utf-8"?>
<!-- The flame-and-pin mark on the launch screens, for screens 440 dp wide and up: the size
     the app's splash draws it at on such a screen (lib/widgets/launch_mark.dart),
     so it doesn't jump when the app takes over. Made by a script from one rule:
     80 dp wide on a 402 dp screen, within 64 and 100, in the image's 410:576. -->
<resources>
    <dimen name="launch_mark_width">87.56dp</dimen>
    <dimen name="launch_mark_height">123.01dp</dimen>
    <!-- Android 12+ (drawable/splash_icon.xml) scales the icon to a
         288 dp box, so there the size is the clear space around it. -->
    <fraction name="launch_mark_inset_x">34.8%</fraction>
    <fraction name="launch_mark_inset_y">28.64%</fraction>
</resources>
